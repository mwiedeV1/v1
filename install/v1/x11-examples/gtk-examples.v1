            "vbox::1" =>  ["size" => [0, 20], /* "hsep" */ ],

  
  
            
            'button:3'  => ["text"=>"Save"],    
             
          ],    
          
          
                 
        ],
        
        "layout" => 
        [   
          
          "name" => "Tabulator 4",
          "button:2" => ["text" => "Text 3", "size"=>[100, 100], "pos"=>[100, 100]],
        ],        
        
        
                
      ]  
    ]
  );
  
  area = gtk_dialog_get_content_area (d);  
	
  gtk_container_add (area, layout);
  gtk_widget_show_all (d);

  ret = gtk_dialog_run (d);
  gtk_widget_destroy  (d);
  return 0;
}


  

function example_dialog2 (window, mainLayout) {
  gtk_window_set_title (window, WINDOW_TITLE.": File Dialog");
  d = gtk_file_chooser_dialog_new ("File Dialog", window, GTK_FILE_CHOOSER_ACTION_OPEN);
  ret = gtk_dialog_run (d);
  if (ret == GTK_RESPONSE_OK) {
    gtkMessageBox (window, "You selected ".gtk_file_chooser_get_filename (d));      
  }
  gtk_widget_destroy  (d);
  return 0;
}


const COL_ID = 0;
const COL_NAME = 1;
const COL_AGE = 2;
const NUM_COLS = 3;

function populate_model(store) {
    iter = "";
	resize (iter, _ALIGN*4);

    gtk_list_store_append(store, iter);
	
    gtk_list_store_set(store, iter, [COL_ID, 3, COL_NAME, "Anna Müller", COL_AGE, rand()%80, -1]);

    gtk_list_store_append(store, iter);
    gtk_list_store_set(store, iter, [COL_ID, 1, COL_NAME, "Bernd Schmidt", COL_AGE, rand()%80, -1]);

    gtk_list_store_append(store, iter);
    gtk_list_store_set(store, iter, [COL_ID, 4, COL_NAME, "Christian Weber", COL_AGE, rand()%80, -1]);

    gtk_list_store_append(store, iter);
    gtk_list_store_set(store, iter, [COL_ID, 2, COL_NAME, "Diana Fischer", COL_AGE, rand()%80, -1]);
	
}

tree_view = null;

function on_stack_visible_child_changed (stack, params, data) {
	global tree_view;
	widget =  gtk_stack_get_visible_child (stack);
	name = gtk_stack_get_visible_child_name (stack);

	if (tree_view) {
		// gtk_container_remove (widget, tree_view);
		gtk_widget_destroy (tree_view);
		tree_view = null;
	}
	
	// 1. GtkListStore mit den Datentypen der Spalten erstellen 
	store = gtk_list_store_new(NUM_COLS, [G_TYPE_INT, G_TYPE_STRING, G_TYPE_INT]);
	populate_model(store);

	// 2. GtkTreeView mit dem Modell verknüpfen
	tree_view = gtk_tree_view_new_with_model(store);
	g_object_unref(store); 

	// Change font size
	provider = gtk_css_provider_new();
	gtk_css_provider_load_from_data(provider, ["treeview.view { font-size: 18px; }", -1, null]);
	context = gtk_widget_get_style_context(tree_view);
	gtk_style_context_add_provider(context, provider, GTK_STYLE_PROVIDER_PRIORITY_APPLICATION);
	g_object_unref(provider);

	// Spalte 1: ID (Integer) 
	renderer = gtk_cell_renderer_text_new();
	column = gtk_tree_view_column_new_with_attributes("ID", renderer, ["text", COL_ID, null]);
	gtk_tree_view_column_set_min_width(column, 50);
	gtk_tree_view_column_set_resizable(column, true);
	gtk_tree_view_append_column(tree_view, column);
	
	// Sortier-ID zuweisen: Aktiviert das Klicken auf den Header 
	gtk_tree_view_column_set_sort_column_id(column, COL_ID);

	// Spalte 2: Name (String)
	renderer = gtk_cell_renderer_text_new();
	column = gtk_tree_view_column_new_with_attributes("Name", renderer, ["text", COL_NAME, null]);
	gtk_tree_view_column_set_resizable(column, true);
	gtk_tree_view_append_column(tree_view, column);
	gtk_tree_view_column_set_min_width(column, 200);

	gtk_tree_view_column_set_sort_column_id(column, COL_NAME);

	// Spalte 3: Alter (Integer) 
	renderer = gtk_cell_renderer_text_new();
	column = gtk_tree_view_column_new_with_attributes("Age", renderer, ["text", COL_AGE, null]);
	gtk_tree_view_column_set_resizable(column, true);

	
	gtk_tree_view_append_column(tree_view, column);
	gtk_tree_view_column_set_sort_column_id(column, COL_AGE);

	// TreeView in das ScrolledWindow packen 
	gtk_container_add(widget, tree_view);
	gtk_widget_show_all (tree_view);
	
}	


function example_sidebar_table (window, mainLayout) {
	global hDLLGTK;
	gtk_window_set_title (window, WINDOW_TITLE.": Sidebar with Table");

	box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
	
	// SIDEBAR
	sidebar = gtk_stack_sidebar_new ();
	gtk_widget_set_size_request(sidebar, 300, -1);
	gtk_box_pack_start(box, sidebar, false, true, 0);

	stack = gtk_stack_new ();
	gtk_widget_set_hexpand (stack, true);
	gtk_widget_set_halign (stack, GTK_ALIGN_FILL);
	
	gtk_stack_set_transition_type (stack, GTK_STACK_TRANSITION_TYPE_SLIDE_UP_DOWN);
	gtk_stack_sidebar_set_stack (sidebar, stack);	
	gtk_box_pack_start(box, stack, false, true, 0);

	pages = array (
		"PAGE 1",
		"PAGE 2",
		"PAGE 3",
		"PAGE 4"	
	);
	foreach (pages as i => name) {		
		widget = gtk_scrolled_window_new ();
		gtk_stack_add_titled  (stack, widget, name, name);
	}	
	g_signal_connect(stack, "notify::visible-child", "on_stack_visible_child_changed:3", null);

	gtk_container_add (mainLayout, box);
	gtk_widget_show_all (window);
	return box;
}


function show_gtk_version (window, mainLayout) {
  global gtkLibName;
  gtkMessageBox (window, "<b>This is a example of V1 Script for GTK to demonstrate how to work with GTK functions.</b>\r\n\r\nGTK Version: <b>".GTK_MAJOR_VERSION.".".GTK_MINOR_VERSION."</b> (".gtkLibName.")\r\n\r\nV1 Script Version: <b>".version ()."</b>\r\n\r\nhttps://v1-script.net");
  return null;
}

function createMenu (menu, list) {
  global hDLLGTK;
  foreach (list as name => data) {
    if (data==="-") {
      gtk_menu_shell_append (menu, gtk_separator_menu_item_new ());
    }
    else {    
      menu_item = gtk_menu_item_new_with_label (name);
      if (is_array (data)) {
        subMenu = gtk_menu_new ();
        createMenu (subMenu, data);
        gtk_menu_item_set_submenu (menu_item, subMenu);
      }
      else
      {
        if (data=="gtk_main_quit")
          g_signal_connect (menu_item, "activate", dlsym (hDLLGTK, "gtk_main_quit")); 
        else
          g_signal_connect (menu_item, "activate", "menu_item_pressed", data);
      }
      gtk_menu_shell_append (menu, menu_item);
    }
  }
}

lastLayout = null;
infobar = null;

function on_infobar_response (info_bar, response_id, user_data)
{	
	global window, mainLayout, lastLayout, cairoTimer, infobar;

	if (cairoTimer) {
		g_source_remove (cairoTimer);
		cairoTimer = null;
	}
	if (lastLayout) {
		gtk_widget_destroy (lastLayout);
		lastLayout = null;
	}
	if (infobar) {
		gtk_widget_destroy (infobar);
		infobar = null;
	}
	
	// Default example
	lastLayout = example_cairo3 (window, mainLayout);
	gtk_widget_show_all (window);
}

function menu_item_pressed (instance, id) {
	global window, mainLayout, lastLayout, cairoTimer, infobar;

	if (function_exists  (id)) {

	if (substr (id, 0, 7)=="example") {
		if (cairoTimer) {
			g_source_remove (cairoTimer);
			cairoTimer = null;
		}

		if (infobar) {
			gtk_widget_destroy (infobar);
			infobar = null;
		}

		if (lastLayout) {
			// gtk_container_remove (mainLayout, lastLayout);
			gtk_widget_destroy (lastLayout);
			lastLayout = null;
		}      

		infobar = gtk_info_bar_new ();
		message_label = gtk_label_new ("Topic");
		gtk_label_set_markup (message_label, '<span size="x-large">V1 GTK Example '.id.'()</span>');
		content_area = gtk_info_bar_get_content_area (infobar);
		gtk_info_bar_set_message_type (infobar, 1);
		g_signal_connect (infobar, "response", "on_infobar_response:3", null);  

		gtk_container_add (content_area, message_label);
		gtk_info_bar_add_button (infobar, "back", 1);	
		gtk_box_pack_start(mainLayout, infobar, false, false, 0);	  
		gtk_widget_show_all (window);
		
		lastLayout = call_user_func (id, window, mainLayout);
		gtk_widget_show_all (window);
	}
	else {
	  call_user_func (id, window, mainLayout);
	}
	}
	else
	gtkMessageBox (window, 'Example <b>'.id.'</b> is not implemented.');

}


